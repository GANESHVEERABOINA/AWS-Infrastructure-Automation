pipeline {
    agent any
    
    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-key')
        AWS_DEFAULT_REGION    = 'ap-south-1' 
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('Terraform: Provision Infra') {
            steps {
                // Terraform folder loki velli run chestundi
                dir('terraform') {
                    sh 'terraform init'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Create Ansible Inventory') {
            steps {
                // Terraform folder nundi IP theeskuni, ansible folder lo unna inventory.txt loki pampisthundi
                sh 'cd terraform && terraform output -raw server_ip > ../ansible/inventory.txt'
                sh 'echo "New Server IP created successfully!"'
            }
        }

        stage('Wait for SSH') {
            steps {
                sleep time: 30, unit: 'SECONDS'
            }
        }

        stage('Ansible: Configure Server') {
            steps {
                // Ansible folder loki velli playbook run chestundi
                dir('ansible') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'aws-agent-1', keyFileVariable: 'SSH_KEY')]) {
                        sh '''
                        export ANSIBLE_HOST_KEY_CHECKING=False
                        ansible-playbook -i inventory.txt -u ec2-user --private-key $SSH_KEY playbook.yml
                        '''
                    }
                }
            }
        }
    }
}